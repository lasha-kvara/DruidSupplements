# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# Public contact numbers (digits with country code). Defaults live in src/config/site.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=995555123456
NEXT_PUBLIC_PHONE_NUMBER=+995555123456
# Optional: your custom domain, e.g. https://druid.ge (Vercel's domain is used automatically otherwise)
NEXT_PUBLIC_SITE_URL=

# Quick-order delivery (server-side, never exposed to visitors). Telegram is tried first.
# 1) Telegram bot: create a bot with @BotFather, message it once, get chat id via
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Formspree (or any endpoint that accepts JSON POST)
FORMSPREE_ENDPOINT=

# With neither set, the quick-order modal asks the customer to send the order via WhatsApp.
