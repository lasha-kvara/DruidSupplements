# Public contact numbers (digits with country code). Override the defaults in src/config/site.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=995555123456
NEXT_PUBLIC_PHONE_NUMBER=+995555123456
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quick-order ("დამირეკეთ") delivery for the static site.
# Create a free form at https://formspree.io and paste its endpoint here.
# Leave empty to open WhatsApp with a pre-filled call-back message instead.
# Everything NEXT_PUBLIC_* is visible to visitors — never put secrets (e.g. Telegram bot tokens) here.
NEXT_PUBLIC_ORDER_ENDPOINT=
