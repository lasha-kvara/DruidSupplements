# Public contact numbers (digits with country code). Override the defaults in src/config/site.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=995555123456
NEXT_PUBLIC_PHONE_NUMBER=+995555123456
NEXT_PUBLIC_SITE_URL=https://druid.ge

# Quick-order delivery. Configure ONE of the options below (Telegram is tried first).
# 1) Telegram bot: create a bot with @BotFather, add it to your chat, get chat id via getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Formspree (or any endpoint that accepts JSON POST)
FORMSPREE_ENDPOINT=
